<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repo manifest for Rockchip Linux SDK (simplified, open-source sources).

  All repositories point to official public mirrors where available.
  Proprietary binaries (rkbin) still come from Rockchip's own GitHub.

  Usage:
    mkdir rksdk && cd rksdk
    repo init -u git@github.com:TommasoLabieni/rksdk -b master -m manifests/default.xml
    repo sync -j8
-->
<manifest>

  <!-- ============================================================
       Default remote / revision
       ============================================================ -->
  <default remote="github" revision="refs/heads/master" sync-j="4"/>

  <!-- ============================================================
       Remotes
       ============================================================ -->

  <!-- Public repos via HTTPS -->
  <remote name="github"
          fetch="https://github.com"
          review="https://github.com"/>

  <!-- Private repos via SSH (requires SSH key configured for GitHub) -->
  <remote name="github-ssh"
          fetch="ssh://git@github.com"
          review="https://github.com"/>

  <!-- ============================================================
       Build system (this SDK repo) — synced to workspace root.
       Uses SSH because the repo is private.
       ============================================================ -->
  <project name="TommasoLabieni/rksdk"
           path="."
           remote="github-ssh"
           revision="refs/heads/master"
           clone-depth="1"/>

  <!-- ============================================================
       Kernel — Rockchip upstream (develop-6.1).
       Rock 5B DTS already present; board-specific overlays in
       device/rockchip/rk3588/dts/ are copied in at build time if needed.
       ============================================================ -->
  <project name="rockchip-linux/kernel"
           path="kernel-6.1"
           remote="github"
           revision="refs/heads/develop-6.1"
           clone-depth="1"/>

  <!-- ============================================================
       U-Boot — Rockchip upstream (next-dev).
       rk3588-rock5b_defconfig already present upstream.
       ============================================================ -->
  <project name="rockchip-linux/u-boot"
           path="u-boot"
           remote="github"
           revision="refs/heads/next-dev"
           clone-depth="1"/>

  <!-- ============================================================
       rkbin — Rockchip proprietary binaries (BL31, DDR init, etc.)
       No open-source alternative exists for these blobs.
       ============================================================ -->
  <project name="rockchip-linux/rkbin"
           path="rkbin"
           remote="github"
           revision="refs/heads/master"
           clone-depth="1"/>

  <!-- ============================================================
       AMP (Asymmetric Multi-Processing) — RT-Thread + Rockchip HAL

       WARNING: The upstream RT-Thread/rt-thread on GitHub does NOT
       contain Rockchip BSPs (bsp/rockchip/rk3588-64 etc.). These
       repos are Rockchip-internal forks distributed with the SDK.

       To enable repo sync for AMP:
         1. Fork rtos/rt-thread/rt-thread from the Rockchip SDK into
            TommasoLabieni/rt-thread on GitHub
         2. Fork rk/mcu/hal and sub-projects similarly
         3. Uncomment the entries below and update the project names

       Until then, populate rtos/ and hal/ manually from the official
       Rockchip Linux SDK release package.

       Source paths in the official Rockchip SDK manifest:
         rtos/rt-thread/rt-thread        → rtos/
         rtos/rt-thread/rtthread-apps    → rtos/applications/rtthread-apps
         rk/mcu/hal                      → hal/  (+ symlink to rtos/bsp/rockchip/common/hal)
         rk/mcu/hal/test                 → hal/test
         rk/mcu/hal/middleware           → hal/middleware
         rk/mcu/hal/applications         → hal/applications
         rk/mcu/hal/board                → hal/board

       Required prebuilt toolchain (already in prebuilts/ if copied from SDK):
         gcc-arm-none-eabi-10-2020-q4-major-x86_64-linux
         → prebuilts/gcc/linux-x86/arm/gcc-arm-none-eabi-10-2020-q4-major-x86_64-linux
       ============================================================ -->
  <!--
  <project name="TommasoLabieni/rt-thread"
           path="rtos"
           remote="github-ssh"
           revision="refs/heads/rockchip-6.1"
           clone-depth="1"/>

  <project name="TommasoLabieni/rtthread-apps"
           path="rtos/applications/rtthread-apps"
           remote="github-ssh"
           revision="refs/heads/rockchip-6.1"
           clone-depth="1"/>

  <project name="TommasoLabieni/hal"
           path="hal"
           remote="github-ssh"
           revision="refs/heads/rockchip-6.1"
           clone-depth="1">
    <linkfile src="." dest="rtos/bsp/rockchip/common/hal"/>
  </project>
  -->

  <!-- ============================================================
       Yocto — meta layers
       ============================================================ -->
  <!-- Poky (OpenEmbedded reference distro) -->
  <project name="yoctoproject/poky"
           path="yocto/poky"
           remote="github"
           revision="refs/heads/scarthgap"
           clone-depth="1"/>

  <!-- OpenEmbedded meta layers -->
  <project name="openembedded/meta-openembedded"
           path="yocto/meta-openembedded"
           remote="github"
           revision="refs/heads/scarthgap"
           clone-depth="1"/>

  <!-- Rockchip Yocto BSP layer — maintained by Rockchip engineer Jeffy Chen -->
  <project name="JeffyCN/meta-rockchip"
           path="yocto/meta-rockchip"
           remote="github"
           revision="refs/heads/scarthgap"
           clone-depth="1"/>

  <!-- ============================================================
       Tools — Rockchip firmware packing and flashing utilities.
       Contains: afptool, rkImageMaker (pack firmware), upgrade_tool
       (Linux USB flash), RKDevTool (Windows flash), and package-file
       templates for all supported chips.
       ============================================================ -->
  <project name="JeffyCN/mirrors"
           path="tools"
           remote="github"
           revision="refs/heads/tools"
           clone-depth="1"/>

  <!-- ============================================================
       rkdeveloptool — open-source alternative to RKDevTool/upgrade_tool.
       Useful for scripted USB flashing without proprietary binaries.
       ============================================================ -->
  <project name="rockchip-linux/rkdeveloptool"
           path="tools/rkdeveloptool"
           remote="github"
           revision="refs/heads/master"
           clone-depth="1"/>

  <!-- ============================================================
       UEFI — No single public Rockchip EDK2 repo covers all chips.
       Chip-specific community forks:
         rk3588: https://github.com/edk2-porting/edk2-rk3588
         rk3576: https://github.com/gahingwoo/edk2-rk3576
       Obtain and place in uefi/ manually if needed.
       ============================================================ -->
  <!-- <project name="edk2-porting/edk2-rk3588" path="uefi" remote="github"/> -->

  <!-- ============================================================
       Prebuilt toolchains
       Not managed by repo — too large for git.
       Download Arm GNU Toolchain from:
         https://developer.arm.com/downloads/-/arm-gnu-toolchain-downloads
       and unpack to prebuilts/gcc/linux-x86/aarch64/
       ============================================================ -->

</manifest>
