From 9efd9356629b03c6cc0c7405ac268d4fd0d6f125 Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 15:29:03 +0200
Subject: [PATCH 05/11] fix: restore hym8563 clock in sdio_pwrseq, drop our
 delay
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The wifi_disable regulator (GPIO4_PA2) provides actual chip VCC from
boot. With VCC always on, BCM43456 responds to CMD5 quickly after
SDIO reset is released — the 100ms post-power-on-delay is not needed.

Restore clocks = <&hym8563> so mmc-pwrseq-simple enables the 32kHz
reference clock before BCM43456 powers up its SDIO interface.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
index 26749d2b6b19..d2a7ed052396 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
@@ -74,10 +74,11 @@ wifi_disable: wifi-diable-gpio-regulator {
 
 	sdio_pwrseq: sdio-pwrseq {
 		compatible = "mmc-pwrseq-simple";
+		clocks = <&hym8563>;
+		clock-names = "ext_clock";
 		pinctrl-names = "default";
 		pinctrl-0 = <&wifi_enable_h>;
 		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
-		post-power-on-delay-ms = <100>;
 	};
 
 	wireless_wlan: wireless-wlan {
-- 
