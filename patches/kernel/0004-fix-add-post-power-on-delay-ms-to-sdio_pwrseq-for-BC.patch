From b8c7817e9af03177ae5b7d5d7a57d65d90d75abf Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 14:41:42 +0200
Subject: [PATCH 04/11] fix: add post-power-on-delay-ms to sdio_pwrseq for
 BCM43456

Without this delay mmc-pwrseq-simple releases WL_REG_ON (PC4) and
immediately starts SDIO CMD5. BCM43456 needs ~100ms after WL_REG_ON
HIGH for its internal oscillators and SDIO block to stabilize.

The missing delay caused CMD5 to run only ~11ms after reset release,
getting no response and aborting enumeration. With 100ms the chip
is ready before the first SDIO command.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
index 8c8a57761d2d..26749d2b6b19 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-rock-5b.dts
@@ -77,6 +77,7 @@ sdio_pwrseq: sdio-pwrseq {
 		pinctrl-names = "default";
 		pinctrl-0 = <&wifi_enable_h>;
 		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <100>;
 	};
 
 	wireless_wlan: wireless-wlan {
-- 
