From 00b15635e3cd9c4c5f363f9f2cc9e45f76e48801 Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 16:02:37 +0200
Subject: [PATCH 06/11] fix: disable bcmdhd; board uses RTL8852BE

Rock5B uses Radxa Wireless Module A8 (RTL8852BE/PCIe), not AP6256.
Remove WL_ROCKCHIP/bcmdhd from defconfig to stop 38s boot delay.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/Makefile       | 1 +
 arch/arm64/configs/rockchip_linux_defconfig | 6 +-----
 2 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index bc5f135d23a1..aeb70e282a52 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -428,3 +428,4 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rv1126bp-evb-v14.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rv1126bp-evb-v14-dual-cam.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rv1126bp-evb1-v12.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rv1126bp-evb1-v12-fastboot-emmc.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-rock-5b.dtb
diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index f9d16c63bc21..2af4c72713c1 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -224,11 +224,7 @@ CONFIG_RK630_PHY=y
 CONFIG_CAN_RK3576=y
 CONFIG_USB_RTL8150=y
 CONFIG_USB_RTL8152=y
-CONFIG_WL_ROCKCHIP=y
-CONFIG_WIFI_BUILD_MODULE=y
-CONFIG_AP6XXX=y
-CONFIG_BCMDHD_FW_PATH="/lib/firmware/ap6256/fw_bcmdhd.bin"
-CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/ap6256/nvram.txt"
+# CONFIG_WL_ROCKCHIP is not set
 CONFIG_INPUT_FF_MEMLESS=y
 CONFIG_INPUT_EVDEV=y
 CONFIG_KEYBOARD_ADC=y
-- 
2.34.1

