From f28849c06396baf349f54095903a6c2c69920786 Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 13:59:00 +0200
Subject: [PATCH 01/11] fix: build AP6XXX (bcmdhd) as built-in

AP6XXX=m requires dhd.ko in /lib/modules but kernel modules are not
installed into the Yocto rootfs (USE_DEPMOD=0, no modules overlay).
Built-in matches how rfkill_rk is already handled.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/configs/rockchip_linux_defconfig | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index c20580b6ee00..f9d16c63bc21 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -201,6 +201,7 @@ CONFIG_NETDEVICES=y
 # CONFIG_NET_VENDOR_QUALCOMM is not set
 # CONFIG_NET_VENDOR_RDC is not set
 CONFIG_R8168=y
+CONFIG_R8169=y
 # CONFIG_NET_VENDOR_RENESAS is not set
 # CONFIG_NET_VENDOR_ROCKER is not set
 # CONFIG_NET_VENDOR_SAMSUNG is not set
@@ -225,7 +226,9 @@ CONFIG_USB_RTL8150=y
 CONFIG_USB_RTL8152=y
 CONFIG_WL_ROCKCHIP=y
 CONFIG_WIFI_BUILD_MODULE=y
-CONFIG_AP6XXX=m
+CONFIG_AP6XXX=y
+CONFIG_BCMDHD_FW_PATH="/lib/firmware/ap6256/fw_bcmdhd.bin"
+CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/ap6256/nvram.txt"
 CONFIG_INPUT_FF_MEMLESS=y
 CONFIG_INPUT_EVDEV=y
 CONFIG_KEYBOARD_ADC=y
-- 
2.34.1

