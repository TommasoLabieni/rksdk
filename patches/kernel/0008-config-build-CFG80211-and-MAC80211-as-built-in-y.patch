From 0d6c3854396fc715aacb33d9c63b5a6ececf05d7 Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 16:37:35 +0200
Subject: [PATCH 08/11] config: build CFG80211 and MAC80211 as built-in (=y)

Yocto rootfs does not install in-tree kernel modules, so =m leaves
cfg80211/mac80211 unreachable at runtime. Built-in keeps the symbols
in the kernel image where rtw89core.ko can resolve them.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/configs/rockchip_linux_defconfig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index 09e2bb4a9428..b97b27527ad6 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -224,8 +224,8 @@ CONFIG_RK630_PHY=y
 CONFIG_CAN_RK3576=y
 CONFIG_USB_RTL8150=y
 CONFIG_USB_RTL8152=y
-CONFIG_CFG80211=m
-CONFIG_MAC80211=m
+CONFIG_CFG80211=y
+CONFIG_MAC80211=y
 # CONFIG_WL_ROCKCHIP is not set
 CONFIG_INPUT_FF_MEMLESS=y
 CONFIG_INPUT_EVDEV=y
-- 
2.34.1

