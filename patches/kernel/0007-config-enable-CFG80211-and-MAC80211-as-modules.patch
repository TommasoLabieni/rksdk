From c3f1419a19dbd5c9776da45248ccd37d080f9376 Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 16:29:43 +0200
Subject: [PATCH 07/11] config: enable CFG80211 and MAC80211 as modules

Required for out-of-tree rtw89 driver (RTL8852BE WiFi).

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/configs/rockchip_linux_defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index 2af4c72713c1..09e2bb4a9428 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -224,6 +224,8 @@ CONFIG_RK630_PHY=y
 CONFIG_CAN_RK3576=y
 CONFIG_USB_RTL8150=y
 CONFIG_USB_RTL8152=y
+CONFIG_CFG80211=m
+CONFIG_MAC80211=m
 # CONFIG_WL_ROCKCHIP is not set
 CONFIG_INPUT_FF_MEMLESS=y
 CONFIG_INPUT_EVDEV=y
-- 
2.34.1

