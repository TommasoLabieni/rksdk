From 9a2bb5c66a9b68e822f66b1cfae130ac1948b14a Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 17:47:49 +0200
Subject: [PATCH 10/11] config: add rock5b.config fragment for WiFi

Moves CFG80211/MAC80211 settings out of shared defconfig into a
board-specific fragment applied via RK_KERNEL_CFG_FRAGMENTS.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/configs/rock5b.config            | 3 +++
 arch/arm64/configs/rockchip_linux_defconfig | 3 ---
 2 files changed, 3 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm64/configs/rock5b.config

diff --git a/arch/arm64/configs/rock5b.config b/arch/arm64/configs/rock5b.config
new file mode 100644
index 000000000000..553576e1f661
--- /dev/null
+++ b/arch/arm64/configs/rock5b.config
@@ -0,0 +1,3 @@
+CONFIG_CFG80211=y
+CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
+CONFIG_MAC80211=y
diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index 2faeff7e7e87..2af4c72713c1 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -224,9 +224,6 @@ CONFIG_RK630_PHY=y
 CONFIG_CAN_RK3576=y
 CONFIG_USB_RTL8150=y
 CONFIG_USB_RTL8152=y
-CONFIG_CFG80211=y
-CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
-CONFIG_MAC80211=y
 # CONFIG_WL_ROCKCHIP is not set
 CONFIG_INPUT_FF_MEMLESS=y
 CONFIG_INPUT_EVDEV=y
-- 
2.34.1

