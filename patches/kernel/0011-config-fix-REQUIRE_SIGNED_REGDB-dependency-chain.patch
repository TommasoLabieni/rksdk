From a746816486359c1663b58c4126c52932bff38e51 Mon Sep 17 00:00:00 2001
From: Tommaso Labieni <tommaso.labieni@entner-electronics.com>
Date: Fri, 26 Jun 2026 17:55:02 +0200
Subject: [PATCH 11/11] config: fix REQUIRE_SIGNED_REGDB dependency chain

REQUIRE_SIGNED_REGDB is only settable when CERTIFICATION_ONUS=y,
which itself requires EXPERT=y.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 arch/arm64/configs/rock5b.config | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/rock5b.config b/arch/arm64/configs/rock5b.config
index 553576e1f661..2a60ad300d72 100644
--- a/arch/arm64/configs/rock5b.config
+++ b/arch/arm64/configs/rock5b.config
@@ -1,3 +1,5 @@
 CONFIG_CFG80211=y
-CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
 CONFIG_MAC80211=y
+CONFIG_EXPERT=y
+CONFIG_CFG80211_CERTIFICATION_ONUS=y
+CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
-- 
2.34.1

