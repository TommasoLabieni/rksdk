# Build artifacts
output/
*.log

# repo tool internal state (kept for backwards compatibility if someone uses repo)
.repo/

# Managed manually — too large or private to be submodules
/rtos/
/hal/
/prebuilts/
/uefi/

# Yocto build output (submodule source trees are tracked, build dir is not)
/yocto/build/

# Host build tools — large binaries, not committed
device/rockchip/common/tools/

# Runtime chip-selection symlink (set by build.sh chip, not committed)
device/rockchip/.chip

# Editor / tooling
.claude/
